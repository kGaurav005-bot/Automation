<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

    <Appenders>

        <Console name="Console"
                 target="SYSTEM_OUT">

            <PatternLayout
                    pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger - %msg%n"/>

        </Console>

        <RollingFile
                name="File"
                fileName="target/logs/automation.log"
                filePattern="target/logs/automation-%d{yyyy-MM-dd}.log.gz">

            <PatternLayout
                    pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger - %msg%n"/>

            <Policies>

                <TimeBasedTriggeringPolicy
                        interval="1"/>

            </Policies>

        </RollingFile>

    </Appenders>

    <Loggers>

        <Root level="INFO">

            <AppenderRef ref="Console"/>

            <AppenderRef ref="File"/>

        </Root>

    </Loggers>

</Configuration>